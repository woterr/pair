# ---------------------------------------------------------------------------
# Android / Gradle
# ---------------------------------------------------------------------------
# Build outputs. Everything here is reproducible from source and is large.
build/
.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# The Kotlin/Gradle caches live inside .gradle and ~/.gradle; this covers the
# project-local daemon and file-watching state.
.kotlin/

# ---------------------------------------------------------------------------
# Local machine configuration - never portable, never shared
# ---------------------------------------------------------------------------
# Contains an absolute path to the Android SDK. Generated by the IDE, and its
# whole purpose is to describe *this* machine. Every developer's is different
# and the SDK is usually in a different place again on CI.
local.properties

# ---------------------------------------------------------------------------
# Signing material
# ---------------------------------------------------------------------------
# Never commit these. The release key in particular: anyone with it can sign a
# build that the Play Store will accept as yours, and a leaked upload key
# cannot be rotated without a full key reset.
*.jks
*.keystore
keystore.properties
signing.properties

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# `.env` is committed on purpose - see the note in the file itself - but any
# real secret that turns up later must not be. This is the rule, not an
# exception for the one file that breaks it.
.env.local
.env.*.local
secrets.properties
*.secret

# ---------------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------------
# `app/google-services.json` IS committed. That is deliberate and it is
# standard: a Firebase client config carries a project id, an app id and an
# API key, none of which are secrets in the server-side sense. The key is
# restricted server-side by package name and signing certificate, and it ships
# inside the APK regardless. Firebase's own documentation permits this, and
# every Firebase Android SDK does the same. Rotating the key, not hiding it,
# is what actually protects the project.
#
# `firebase-debug.log`, `.firebase/` and the hosting/cache artefacts are local
# and do not belong here.
firebase-debug.log
firebase-debug.*.log
.firebase/
database.rules.json.bak
*-debug.html
*-debug.css

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.cxx/
captures/
.externalNativeBuild/

# VS Code / Android Studio misc
.vscode/*
!.vscode/extensions.json
.navigation/
.studio/

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# Test and report output
# ---------------------------------------------------------------------------
# The render harness writes its screenshots here. They are regenerated by
# `:app:testDebugUnitTest` and only bloat diffs.
app/build/screenshots/
reports/
*.hprof

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
# macOS
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
ehthumbs.db
Thumbs.db:encryptable
desktop.ini
