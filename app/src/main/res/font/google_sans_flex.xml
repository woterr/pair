<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Sans Flex, 24pt optical size.

    24pt is the optical instance intended for interface text. A separate
    `gsf_black_display` (120pt) is used for the wordmark, where the larger optical size
    keeps the joints and spacing correct at display scale.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/gsf_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/gsf_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/gsf_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/gsf_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/gsf_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800" />
    <font
        android:font="@font/gsf_black"
        android:fontStyle="normal"
        android:fontWeight="900" />
</font-family>
