<?xml version="1.0" encoding="utf-8"?>
<!--
    Roboto Serif Italic, used only for the serif role in the design — the "Partner" wordmark and
    the partner's name on the room screen.

    The brief asks for the *lightest* weight, so Thin is the family's default. The partner's name
    on the room screen is a step up to Light: at 26sp against a moving background, Thin is legible
    only on a perfect display, and that is not a good enough trade for a name.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/rs_thinitalic"
        android:fontStyle="italic"
        android:fontWeight="100" />
    <font
        android:font="@font/rs_lightitalic"
        android:fontStyle="italic"
        android:fontWeight="300" />
    <font
        android:font="@font/rs_italic"
        android:fontStyle="italic"
        android:fontWeight="400" />
    <font
        android:font="@font/rs_mediumitalic"
        android:fontStyle="italic"
        android:fontWeight="500" />
</font-family>
