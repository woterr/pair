<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon.

    Foreground: the flower with the mark cut out of it (see ic_launcher_foreground).
    Monochrome: the outline of the mark, at the same 58dp as the foreground and on the same canvas.
    See ic_launcher_monochrome for why that is its own file rather than the 1249dp blob.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
