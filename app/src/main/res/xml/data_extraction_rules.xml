<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer rules.

    As with backup_rules.xml: only the app's own DataStore travels, and everything else is
    left behind by omission rather than by a list of excludes. Naming a domain that the single
    <include> never covered is an error the resource compiler rejects, and it buys nothing —
    an omitted path is already excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
